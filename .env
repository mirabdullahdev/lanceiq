# Committed defaults. Nothing secret belongs in this file — everything here
# is inlined into the public bundle at build time. Real secrets live in
# Supabase function secrets and in GitHub repository secrets.
#
# The canonical origin, used for <link rel=canonical>, og:url and og:image.
# Change this in exactly one place and index.html + config/site.ts follow.
VITE_SITE_ORIGIN=https://lancewise.com

# Supabase edge function. Project "LanceWise", region ap-south-1 (Mumbai).
# Public URL, not a secret — the endpoint is deployed with --no-verify-jwt and
# does its own validation. See supabase/README.md.
VITE_WAITLIST_ENDPOINT=https://ytdqfhkwbnoadimmemdi.supabase.co/functions/v1/subscribe


# Plausible site domain. Leave empty to ship with no analytics at all.
VITE_PLAUSIBLE_DOMAIN=
